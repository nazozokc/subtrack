{
  "name": "subtrack",
  "version": "10.0.0",
  "author": "nazozokc",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "bin": {
    "subtrack": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "CLI tool to manage subscription services from the terminal",
  "keywords": [
    "cli",
    "subscription",
    "finance",
    "tracker",
    "terminal",
    "sqlite",
    "budget"
  ],
  "homepage": "https://github.com/nazozokc/subtrack",
  "bugs": {
    "url": "https://github.com/nazozokc/subtrack/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nazozokc/subtrack.git"
  },
  "engines": {
    "node": ">=22.5"
  },
  "sideEffects": false,
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "start": "tsx --no-warnings src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:typos": "command -v typos >/dev/null 2>&1 && typos || echo 'typos not installed, skipping'",
    "lint:security": "pnpm audit --audit-level=high",
    "lint:types": "tsc --noEmit",
    "lint:lockfile": "node -e \"process.exit(require('fs').readFileSync('../../pnpm-lock.yaml','utf8').startsWith('lockfileVersion')?0:1)\"",
    "lint:dedupe": "pnpm dedupe --check",
    "lint:secrets": "secretlint \"src/**/*.ts\""
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tsc --noEmit"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gunshi": "^0.37.1",
    "imapflow": "^1.7.6",
    "@subtrack/lib": "workspace:*"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "secretlint": "^13.0.5",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
