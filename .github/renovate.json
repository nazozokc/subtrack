{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "npm:unpublishSafe",
    ":pinAllExceptPeerDependencies",
    ":disableRateLimiting"
  ],
  "enabledManagers": ["npm", "github-actions", "cargo"],
  "schedule": ["before 9am on monday"],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "14 days",
  "fetchReleaseNotes": true,
  "rangeStrategy": "bump",
  "labels": ["dependencies"],
  "assignees": ["nazozokc"],
  "reviewers": ["nazozokc"],
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "configMigration": true,
  "branchConcurrentLimit": 5,
  "prConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Auto-merge minor and patch devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Major devDependencies require dashboard approval",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group minor/patch runtime dependency updates",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "runtime dependencies",
      "automerge": true
    },
    {
      "description": "Major runtime dependencies require dashboard approval",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "runtime major updates",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and auto-merge minor/patch Rust crate updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "rust crates",
      "automerge": true
    },
    {
      "description": "Major Rust crate updates require dashboard approval",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["major"],
      "groupName": "rust crate major updates",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and auto-merge GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["dependencies", "ci"],
      "automerge": true
    },
    {
      "description": "Silence engine requirement bumps",
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "osvVulnerabilityAlerts": true
}
