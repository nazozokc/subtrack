{
  "name": "subtrack-monorepo",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint:security": "pnpm -r lint:security",
    "format": "nix fmt",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "workspaces": [
    "packages/subtrack",
    "packages/subtrack-*",
    "docs"
  ],
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "js-yaml": ">=5.2.2",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.18",
    "vite": ">=7.3.7 <8",
    "esbuild": ">=0.24.3",
    "vue": ">=3.5.42",
    "source-map-js": ">=1.2.2"
  }
}
